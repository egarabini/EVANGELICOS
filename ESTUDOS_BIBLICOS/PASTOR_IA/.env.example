# DAVID Pastoral — Variáveis de Ambiente
# Copie para .env e preencha os valores

# PostgreSQL
POSTGRES_PASSWORD=troque_por_senha_segura

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
OLLAMA_TEMPERATURE=0.2    # pipeline (baixo = determinístico)

# Caminhos locais (Windows — ajuste se necessário)
BIBLIA_SOURCE_DIR=./rag/biblia/sources
ESTUDOS_DIR=./admin_module/biblioteca/estudos
